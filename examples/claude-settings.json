{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/rabbit-hole/hooks/claude-code/user-prompt-submit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/rabbit-hole/hooks/claude-code/pre-tool-use.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
